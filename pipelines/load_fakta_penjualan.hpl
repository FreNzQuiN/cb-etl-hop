  <transform>
    <type>ScriptValueMod</type>
    <name>JavaScript (Seragamkan Tanggal)</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>   var bulanIndo = {"Jan":1,"Feb":2,"Mar":3,"Apr":4,"Mei":5,"Jun":6,
                    "Jul":7,"Agu":8,"Sep":9,"Okt":10,"Nov":11,"Des":12};
   var s = String(tanggal).trim();
   var m;
   var y = null;
   var bln = null;
   var hr = null;

   if ((m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/)) != null) {
     // format 2025-09-23
     y = Number(m[1]); bln = Number(m[2]); hr = Number(m[3]);
   } else if ((m = s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/)) != null) {
     // format 08/12/2025 atau 19-04-2025 (tanggal-bulan-tahun)
     hr = Number(m[1]); bln = Number(m[2]); y = Number(m[3]);
   } else if ((m = s.match(/^(\d{1,2}) ([A-Za-z]{3}) (\d{4})$/)) != null) {
     // format 5 Mar 2025 (singkatan bulan Indonesia)
     hr = Number(m[1]); bln = bulanIndo[m[2]]; y = Number(m[3]);
   }

   var waktu_key = null;
   var tanggal_bersih = null;
   if (y != null &amp;&amp; bln != null &amp;&amp; hr != null) {
     waktu_key = y * 10000 + bln * 100 + hr;
     tanggal_bersih = y + "-" + (bln &lt; 10 ? "0" : "") + bln + "-" + (hr &lt; 10 ? "0" : "") + hr;
   }</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>waktu_key</name>
        <rename>waktu_key</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>tanggal_bersih</name>
        <rename>tanggal_bersih</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <languageVersion>ES6</languageVersion>
