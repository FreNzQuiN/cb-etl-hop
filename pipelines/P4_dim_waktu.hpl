<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>P4_dim_waktu</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Bangun dimensi waktu dari transaksi yang lolos validasi</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/21 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Transaksi Bersih</from>
      <to>Atribut Waktu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Atribut Waktu</from>
      <to>Unik Tanggal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Unik Tanggal</from>
      <to>Pilih Dimensi Waktu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pilih Dimensi Waktu</from>
      <to>Muat Dim Waktu</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Transaksi Bersih</name>
    <type>CSVInput</type>
    <description>Sumber transaksi hasil cleansing P1</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/out/transaksi_bersih.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_transaksi</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>tanggal</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_produk</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_pelanggan</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>qty</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>harga_satuan</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>total_penjualan</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>metode_bayar</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Atribut Waktu</name>
    <type>SuperScript</type>
    <description>Turunkan atribut kalender dari tanggal transaksi</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <scriptLanguage>javascript</scriptLanguage>
    <scripts>
      <script>
        <scriptType>0</scriptType>
        <scriptName>Transform</scriptName>
        <scriptBody>var NAMA_BULAN = [&quot;Januari&quot;,&quot;Februari&quot;,&quot;Maret&quot;,&quot;April&quot;,&quot;Mei&quot;,&quot;Juni&quot;,&quot;Juli&quot;,&quot;Agustus&quot;,&quot;September&quot;,&quot;Oktober&quot;,&quot;November&quot;,&quot;Desember&quot;];
var NAMA_HARI = [&quot;Minggu&quot;,&quot;Senin&quot;,&quot;Selasa&quot;,&quot;Rabu&quot;,&quot;Kamis&quot;,&quot;Jumat&quot;,&quot;Sabtu&quot;];
var thn = 0;
var bln = 0;
var hr = 0;
if (tanggal !== null &amp;&amp; tanggal !== undefined) {
  if (typeof tanggal.getFullYear === &quot;function&quot;) {
    thn = tanggal.getFullYear();
    bln = tanggal.getMonth() + 1;
    hr = tanggal.getDate();
  } else if (typeof tanggal.getYear === &quot;function&quot;) {
    thn = tanggal.getYear() + 1900;
    bln = tanggal.getMonth() + 1;
    hr = tanggal.getDate();
  } else {
    var m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(String(tanggal).trim());
    if (m !== null) {
      thn = parseInt(m[1], 10);
      bln = parseInt(m[2], 10);
      hr = parseInt(m[3], 10);
    }
  }
}
hari = hr;
bulan = bln;
kuartal = Math.ceil(bln / 3);
tahun = thn;
namaBulan = NAMA_BULAN[bln - 1];
namaHari = NAMA_HARI[new Date(Date.UTC(thn, bln - 1, hr)).getUTCDay()];</scriptBody>
      </script>
    </scripts>
    <fields>
      <field>
        <name>hari</name>
        <rename>hari</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>namaHari</name>
        <rename>namaHari</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>bulan</name>
        <rename>bulan</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>namaBulan</name>
        <rename>namaBulan</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>kuartal</name>
        <rename>kuartal</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>tahun</name>
        <rename>tahun</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>260</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Unik Tanggal</name>
    <type>UniqueRowsByHashSet</type>
    <description>Ambil satu baris per tanggal</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <fields>
      <field>
        <name>tanggal</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <attributes/>
    <GUI>
      <xloc>420</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Pilih Dimensi Waktu</name>
    <type>SelectValues</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>tanggal</name>
        <rename>tanggal</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>hari</name>
        <rename>hari</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>namaHari</name>
        <rename>nama_hari</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>bulan</name>
        <rename>bulan</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>namaBulan</name>
        <rename>nama_bulan</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>kuartal</name>
        <rename>kuartal</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>tahun</name>
        <rename>tahun</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
    </fields>
    <select_unspecified>N</select_unspecified>
    <attributes/>
    <GUI>
      <xloc>580</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Muat Dim Waktu</name>
    <type>TableOutput</type>
    <description>Muat dimensi waktu ke PostgreSQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>500</commit>
    <connection>tokomaju_dw</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_waktu</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>740</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <attributes>
  </attributes>
  <GUI>
    <xloc>50</xloc>
    <yloc>50</yloc>
  </GUI>
</pipeline>
