<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>P3_dim_pelanggan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Muat dimensi pelanggan dari database OLTP</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/21 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Tabel Pelanggan</from>
      <to>Normalisasi Pelanggan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalisasi Pelanggan</from>
      <to>Pilih Master Pelanggan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pilih Master Pelanggan</from>
      <to>Muat Dim Pelanggan</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Tabel Pelanggan</name>
    <type>TableInput</type>
    <description>Sumber master pelanggan dari database OLTP TokoMaju</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tokomaju_oltp</connection>
    <sql>SELECT id_pelanggan, nama, jenis_kelamin, kota, provinsi, telepon, email, tgl_daftar FROM pelanggan</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Normalisasi Pelanggan</name>
    <type>SuperScript</type>
    <description>Isi kota kosong, rapikan nama, seragamkan nomor telepon</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <scriptLanguage>javascript</scriptLanguage>
    <scripts>
      <script>
        <scriptType>0</scriptType>
        <scriptName>Transform</scriptName>
        <scriptBody>var rapikan = function (s) {
  if (s === null || s === undefined) { return &quot;&quot;; }
  return String(s).replace(/\s+/g, &quot; &quot;).trim();
};
var kosong = function (s) { return s === null || s === undefined || String(s).trim() === &quot;&quot;; };
namaBersih = rapikan(nama);
kotaNorm = kosong(kota) ? &quot;Tidak Diketahui&quot; : rapikan(kota);
provinsiNorm = kosong(provinsi) ? &quot;&quot; : rapikan(provinsi);
jenisNorm = kosong(jenis_kelamin) ? &quot;&quot; : rapikan(jenis_kelamin);
var tel = kosong(telepon) ? &quot;&quot; : String(telepon).replace(/[^0-9]/g, &quot;&quot;);
if (tel.indexOf(&quot;62&quot;) === 0) {
  tel = &quot;0&quot; + tel.substring(2);
} else if (tel !== &quot;&quot; &amp;&amp; tel.indexOf(&quot;0&quot;) !== 0) {
  tel = &quot;0&quot; + tel;
}
teleponNorm = tel;</scriptBody>
      </script>
    </scripts>
    <fields>
      <field>
        <name>namaBersih</name>
        <rename>namaBersih</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>jenisNorm</name>
        <rename>jenisNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>kotaNorm</name>
        <rename>kotaNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>provinsiNorm</name>
        <rename>provinsiNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>teleponNorm</name>
        <rename>teleponNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>260</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Pilih Master Pelanggan</name>
    <type>SelectValues</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id_pelanggan</name>
        <rename>id_pelanggan</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>namaBersih</name>
        <rename>nama</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>jenisNorm</name>
        <rename>jenis_kelamin</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>kotaNorm</name>
        <rename>kota</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>provinsiNorm</name>
        <rename>provinsi</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>teleponNorm</name>
        <rename>telepon</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
    </fields>
    <select_unspecified>N</select_unspecified>
    <attributes/>
    <GUI>
      <xloc>420</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Muat Dim Pelanggan</name>
    <type>TableOutput</type>
    <description>Muat dimensi pelanggan ke PostgreSQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>500</commit>
    <connection>tokomaju_dw</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_pelanggan</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>580</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <attributes>
  </attributes>
  <GUI>
    <xloc>50</xloc>
    <yloc>50</yloc>
  </GUI>
</pipeline>
