<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>P2_dim_produk</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Muat dimensi produk dengan kategori yang sudah seragam</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/21 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Master Produk</from>
      <to>Buang Duplikat Produk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buang Duplikat Produk</from>
      <to>Normalisasi Kategori</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalisasi Kategori</from>
      <to>Pilih Master Produk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pilih Master Produk</from>
      <to>Muat Dim Produk</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Master Produk</name>
    <type>ExcelInput</type>
    <description>Sumber master produk dan kategori format Excel</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <accept_filenames>N</accept_filenames>
    <add_to_result_filenames>N</add_to_result_filenames>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_ignored>N</error_ignored>
    <error_line_files_extension>error</error_line_files_extension>
    <error_line_skipped>N</error_line_skipped>
    <fields>
      <field>
        <name>id_produk</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>nama_produk</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>kategori</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>merek</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <file>
      <file_required>N</file_required>
      <filemask>${PROJECT_HOME}/data/produk.xlsx</filemask>
      <include_subfolders>N</include_subfolders>
      <name>${PROJECT_HOME}/data/produk.xlsx</name>
    </file>
    <header>Y</header>
    <ignore_fields>N</ignore_fields>
    <limit>0</limit>
    <line_number_files_extension>line</line_number_files_extension>
    <noempty>Y</noempty>
    <sheetrownumfield>sheet_row</sheetrownumfield>
    <sheets>
      <sheet>
        <name>Produk</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
        <is_regex>N</is_regex>
      </sheet>
    </sheets>
    <shortFileFieldName>short_filename</shortFileFieldName>
    <spreadsheet_type>SAX_POI</spreadsheet_type>
    <stoponempty>N</stoponempty>
    <strict_types>N</strict_types>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Buang Duplikat Produk</name>
    <type>UniqueRowsByHashSet</type>
    <description>Buang baris produk kembar pada master</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <fields>
      <field>
        <name>id_produk</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <attributes/>
    <GUI>
      <xloc>260</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Normalisasi Kategori</name>
    <type>SuperScript</type>
    <description>Rapikan nama produk dan seragamkan nama kategori</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <scriptLanguage>javascript</scriptLanguage>
    <scripts>
      <script>
        <scriptType>0</scriptType>
        <scriptName>Transform</scriptName>
        <scriptBody>var rapikan = function (s) {
  if (s === null || s === undefined) { return &quot;&quot;; }
  return String(s).replace(/\s+/g, &quot; &quot;).trim();
};
var judul = function (s) {
  var t = rapikan(s).toLowerCase();
  return t.replace(/(^|\s)([a-z])/g, function (seluruh, spasi, huruf) { return spasi + huruf.toUpperCase(); });
};
idProduk = rapikan(id_produk);
namaProduk = rapikan(nama_produk);
var kat = judul(kategori);
kat = kat.replace(/\bDan\b/g, &quot;&amp;&quot;);
if (kat === &quot;Mamin&quot;) { kat = &quot;Makanan &amp; Minuman&quot;; }
if (kat === &quot;&quot;) { kat = &quot;Tidak Diketahui&quot;; }
kategoriNorm = kat;
merekNorm = rapikan(merek);</scriptBody>
      </script>
    </scripts>
    <fields>
      <field>
        <name>idProduk</name>
        <rename>idProduk</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>namaProduk</name>
        <rename>namaProduk</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>kategoriNorm</name>
        <rename>kategoriNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
        <name>merekNorm</name>
        <rename>merekNorm</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>420</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Pilih Master Produk</name>
    <type>SelectValues</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>idProduk</name>
        <rename>id_produk</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>namaProduk</name>
        <rename>nama_produk</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>kategoriNorm</name>
        <rename>kategori</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>merekNorm</name>
        <rename>merek</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
    </fields>
    <select_unspecified>N</select_unspecified>
    <attributes/>
    <GUI>
      <xloc>580</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Muat Dim Produk</name>
    <type>TableOutput</type>
    <description>Muat dimensi produk ke PostgreSQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>500</commit>
    <connection>tokomaju_dw</connection>
    <fields>
    </fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>dim_produk</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>740</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <attributes>
  </attributes>
  <GUI>
    <xloc>50</xloc>
    <yloc>50</yloc>
  </GUI>
</pipeline>
