      </field>
      <field>
        <name>qty</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>harga_satuan</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>metode_bayar</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Buang Duplikat</name>
    <type>UniqueRowsByHashSet</type>
    <description>Buang transaksi kembar berdasarkan id_transaksi</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <fields>
      <field>
        <name>id_transaksi</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <attributes/>
    <GUI>
      <xloc>260</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Normalisasi</name>
    <type>SuperScript</type>
    <description>Seragamkan tanggal dan harga, hitung total, beri alasan penolakan</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <scriptLanguage>javascript</scriptLanguage>
    <scripts>
      <script>
        <scriptType>0</scriptType>
        <scriptName>Transform</scriptName>
        <scriptBody>var BULAN = {jan:1,feb:2,mar:3,apr:4,mei:5,jun:6,jul:7,agu:8,sep:9,okt:10,nov:11,des:12};
var rawId = id_transaksi === null || id_transaksi === undefined ? &quot;&quot; : String(id_transaksi).trim();
var rawTgl = tanggal === null || tanggal === undefined ? &quot;&quot; : String(tanggal).trim();
var rawProd = id_produk === null || id_produk === undefined ? &quot;&quot; : String(id_produk).trim();
var rawPel = id_pelanggan === null || id_pelanggan === undefined ? &quot;&quot; : String(id_pelanggan).trim();
var rawQty = qty === null || qty === undefined ? &quot;&quot; : String(qty).trim();
var rawHrg = harga_satuan === null || harga_satuan === undefined ? &quot;&quot; : String(harga_satuan).trim();
var rawBayar = metode_bayar === null || metode_bayar === undefined ? &quot;&quot; : String(metode_bayar).trim();
var parseTgl = function (s) {
  var m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
  if (m !== null) { return [parseInt(m[1], 10), parseInt(m[2], 10), parseInt(m[3], 10)]; }
  m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
  if (m !== null) { return [parseInt(m[3], 10), parseInt(m[2], 10), parseInt(m[1], 10)]; }
  m = /^(\d{1,2})-(\d{1,2})-(\d{4})$/.exec(s);
  if (m !== null) { return [parseInt(m[3], 10), parseInt(m[2], 10), parseInt(m[1], 10)]; }
  m = /^(\d{1,2})\s+([A-Za-z]{3,9})\s+(\d{4})$/.exec(s);
  if (m !== null) {
    var kunci = m[2].toLowerCase().substring(0, 3);
    if (BULAN[kunci] !== undefined) { return [parseInt(m[3], 10), BULAN[kunci], parseInt(m[1], 10)]; }
  }
  return null;
};
var parts = parseTgl(rawTgl);
var thn = 0;
var bln = 0;
var hr = 0;
var tglOk = false;
if (parts !== null) {
  thn = parts[0];
  bln = parts[1];
  hr = parts[2];
  var cek = new Date(Date.UTC(thn, bln - 1, hr));
  if (cek.getUTCFullYear() === thn &amp;&amp; cek.getUTCMonth() + 1 === bln &amp;&amp; cek.getUTCDate() === hr) { tglOk = true; }
}
var pad = function (x) { return x &lt; 10 ? &quot;0&quot; + x : &quot;&quot; + x; };
tanggalISO = tglOk ? (thn + &quot;-&quot; + pad(bln) + &quot;-&quot; + pad(hr)) : &quot;&quot;;
var toInt = function (s) {
  if (s === null || s === undefined) { return null; }
  var teks = String(s).trim();
  if (teks === &quot;&quot;) { return null; }
  teks = teks.replace(/^Rp\.?/i, &quot;&quot;);
  teks = teks.replace(/\s/g, &quot;&quot;);
  if (/^\d{1,3}(\.\d{3})+$/.test(teks)) { teks = teks.replace(/\./g, &quot;&quot;); }
  if (/^-?\d+$/.test(teks)) { return parseInt(teks, 10); }
  return null;
};
var nQty = toInt(rawQty);
var nHrg = toInt(rawHrg);
alasan = &quot;&quot;;
if (rawId === &quot;&quot;) { alasan = &quot;id transaksi kosong&quot;; }
if (alasan === &quot;&quot; &amp;&amp; !tglOk) { alasan = &quot;tanggal tidak valid&quot;; }
if (alasan === &quot;&quot; &amp;&amp; nQty === null) { alasan = &quot;jumlah terjual tidak valid&quot;; }
if (alasan === &quot;&quot; &amp;&amp; nQty &lt; 0) { alasan = &quot;jumlah terjual negatif&quot;; }
if (alasan === &quot;&quot; &amp;&amp; nQty === 0) { alasan = &quot;jumlah terjual nol&quot;; }
if (alasan === &quot;&quot; &amp;&amp; nHrg === null) { alasan = &quot;harga satuan tidak valid&quot;; }
if (alasan === &quot;&quot; &amp;&amp; nHrg &lt;= 0) { alasan = &quot;harga satuan tidak valid&quot;; }
if (alasan === &quot;&quot; &amp;&amp; rawProd === &quot;&quot;) { alasan = &quot;id produk kosong&quot;; }
if (alasan === &quot;&quot; &amp;&amp; rawPel === &quot;&quot;) { alasan = &quot;id pelanggan kosong&quot;; }
if (alasan === &quot;&quot; &amp;&amp; rawBayar === &quot;&quot;) { alasan = &quot;metode bayar kosong&quot;; }
qtyInt = nQty === null ? 0 : nQty;
hargaInt = nHrg === null ? 0 : nHrg;
totalPenjualan = alasan === &quot;&quot; ? nQty * nHrg : 0;
valid = alasan === &quot;&quot; ? 1 : 0;</scriptBody>
      </script>
    </scripts>
    <fields>
      <field>
        <name>tanggalISO</name>
        <rename>tanggalISO</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
      <field>
