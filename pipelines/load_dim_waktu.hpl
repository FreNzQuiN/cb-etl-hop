        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>nama_bulan</name>
        <rename>nama_bulan</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>kuartal</name>
        <rename>kuartal</rename>
        <type>Integer</type>
