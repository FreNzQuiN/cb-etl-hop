    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Sequence</type>
    <name>Add sequence (Nomor Urut Hari)</name>
    <valuename>hari_ke</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>0</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>272</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>JavaScript (Hitung Atribut Kalender)</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>   var namaHari  = ["Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"];
   var namaBulan = ["Januari","Februari","Maret","April","Mei","Juni",
                    "Juli","Agustus","September","Oktober","November","Desember"];

   var tanggal    = new Date(2025, 0, 1 + Number(hari_ke));
   var tahun      = tanggal.getFullYear();
   var bulan      = tanggal.getMonth() + 1;
   var hari       = namaHari[tanggal.getDay()];
   var nama_bulan = namaBulan[tanggal.getMonth()];
   var kuartal    = Math.floor((bulan - 1) / 3) + 1;
   var waktu_key  = tahun * 10000 + bulan * 100 + tanggal.getDate();</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>tanggal</name>
        <rename>tanggal</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>tahun</name>
        <rename>tahun</rename>
        <type>Integer</type>
        <length>16</length>
        <precision>2</precision>
