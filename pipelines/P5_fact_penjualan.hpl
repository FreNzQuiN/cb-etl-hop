    <lookup>
      <schema>public</schema>
      <table>dim_pelanggan</table>
      <key>
        <name>id_pelanggan</name>
        <condition>=</condition>
        <field>id_pelanggan</field>
      </key>
      <value>
        <name>customer_sk</name>
        <rename>customer_sk</rename>
        <default></default>
