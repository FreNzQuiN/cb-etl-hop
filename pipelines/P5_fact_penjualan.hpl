  <transform>
    <name>Catat Alasan</name>
    <type>SuperScript</type>
    <description>Tandai alasan saat produk tidak ditemukan di master</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <scriptLanguage>javascript</scriptLanguage>
    <scripts>
      <script>
        <scriptType>0</scriptType>
        <scriptName>Transform</scriptName>
        <scriptBody>alasan = &quot;produk tidak ditemukan di master produk&quot;;</scriptBody>
      </script>
    </scripts>
    <fields>
      <field>
        <name>alasan</name>
        <rename>alasan</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
        <scriptResult>N</scriptResult>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>740</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Cek Produk Master</name>
    <type>FilterRows</type>
    <description>Pisahkan transaksi yang produknya ada di master</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
        </conditions>
        <function>></function>
        <leftvalue>product_sk</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <mask>####0;-####0</mask>
          <name>constant</name>
          <precision>0</precision>
          <text>0</text>
          <type>Integer</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Produk Tidak Dikenal</send_false_to>
    <send_true_to>Siap Muat</send_true_to>
    <attributes/>
    <GUI>
      <xloc>900</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
