      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup Produk</name>
    <type>DBLookup</type>
    <description>Ambil surrogate key dimensi produk, 0 bila produk tidak ada di master</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
