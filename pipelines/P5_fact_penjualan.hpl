<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>P5_fact_penjualan</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Muat tabel fakta penjualan dengan surrogate key dimensi</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/21 09:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/21 09:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Transaksi Bersih</from>
      <to>Lookup Waktu</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Waktu</from>
      <to>Lookup Pelanggan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Pelanggan</from>
      <to>Lookup Produk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Produk</from>
      <to>Catat Alasan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Catat Alasan</from>
      <to>Cek Produk Master</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Cek Produk Master</from>
      <to>Siap Muat</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Cek Produk Master</from>
      <to>Produk Tidak Dikenal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Siap Muat</from>
      <to>Pilih Fakta</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pilih Fakta</from>
      <to>Muat Fakta</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Produk Tidak Dikenal</from>
      <to>Pilih Karantina</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pilih Karantina</from>
      <to>Berkas Karantina</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Transaksi Bersih</name>
    <type>CSVInput</type>
    <description>Sumber transaksi hasil cleansing P1</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/out/transaksi_bersih.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_transaksi</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>tanggal</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_produk</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>id_pelanggan</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>qty</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>harga_satuan</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>total_penjualan</name>
        <type>Integer</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>metode_bayar</name>
        <type>String</type>
        <format></format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup Waktu</name>
    <type>DBLookup</type>
    <description>Ambil surrogate key dimensi waktu</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tokomaju_dw</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>public</schema>
      <table>dim_waktu</table>
      <key>
        <name>tanggal</name>
        <condition>=</condition>
        <field>tanggal</field>
      </key>
      <value>
        <name>date_sk</name>
        <rename>date_sk</rename>
        <default></default>
        <type>Integer</type>
      </value>
      <fail_on_multiple>Y</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>260</xloc>
      <yloc>100</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup Pelanggan</name>
    <type>DBLookup</type>
    <description>Ambil surrogate key dimensi pelanggan</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
